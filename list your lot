<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>List Your Lot — RGV Autos</title>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--navy:#0A1628;--navy2:#111f3a;--orange:#F97316;--orange2:#ea6a0a;--white:#ffffff;--gray:#f4f5f7;--muted:#6b7280;--text:#1a2332;--border:#dde1e8;}
html{scroll-behavior:smooth}
body{font-family:'Barlow',sans-serif;color:var(--text);background:var(--white);line-height:1.6}
a{text-decoration:none;color:inherit}

nav{background:var(--navy);padding:0 2rem;display:flex;align-items:center;justify-content:space-between;height:64px;position:sticky;top:0;z-index:100}
.nav-logo{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.6rem;color:var(--white)}
.nav-logo span{color:var(--orange)}
.nav-links{display:flex;gap:2rem;align-items:center}
.nav-links a{color:rgba(255,255,255,.75);font-size:.9rem;font-weight:500;transition:color .2s}
.nav-links a:hover{color:var(--white)}
.nav-cta{background:var(--orange);color:var(--white)!important;padding:.45rem 1.2rem;border-radius:6px;font-weight:600!important}

/* HERO */
.hero{background:var(--navy);padding:5rem 2rem 5rem;text-align:center;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 110%,rgba(249,115,22,.2),transparent 70%);pointer-events:none}
.hero-badge{display:inline-block;background:rgba(249,115,22,.15);border:1px solid rgba(249,115,22,.4);color:var(--orange);font-size:.78rem;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;padding:.35rem 1rem;border-radius:99px;margin-bottom:1.5rem}
.hero h1{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2.6rem,6vw,4.5rem);color:var(--white);line-height:1.05;margin-bottom:1rem}
.hero h1 span{color:var(--orange)}
.hero p{color:rgba(255,255,255,.65);font-size:1.1rem;max-width:560px;margin:0 auto 2.5rem}
.hero-btns{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap}
.btn-primary{background:var(--orange);color:var(--white);padding:.85rem 2.2rem;border-radius:8px;font-family:'Barlow',sans-serif;font-weight:600;font-size:1rem;border:none;cursor:pointer;transition:background .2s}
.btn-primary:hover{background:var(--orange2)}
.btn-secondary{background:transparent;color:var(--white);padding:.85rem 2.2rem;border-radius:8px;font-family:'Barlow',sans-serif;font-weight:600;font-size:1rem;border:2px solid rgba(255,255,255,.3);cursor:pointer;transition:border .2s}
.btn-secondary:hover{border-color:rgba(255,255,255,.7)}

/* STATS BAR */
.stats-bar{background:var(--orange);padding:1.5rem 2rem;display:flex;justify-content:center;gap:5rem;flex-wrap:wrap}
.stat-item{text-align:center}
.stat-num{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:2rem;color:var(--white);line-height:1}
.stat-label{font-size:.82rem;color:rgba(255,255,255,.8);font-weight:500;margin-top:2px}

/* SECTIONS */
.section{padding:5rem 2rem}
.container{max-width:1100px;margin:0 auto}
.section-label{font-size:.78rem;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--orange);margin-bottom:.75rem}
.section-title{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:2.4rem;color:var(--navy);margin-bottom:1rem;line-height:1.1}
.section-sub{color:var(--muted);font-size:1.05rem;max-width:580px;line-height:1.7}

/* HOW IT WORKS */
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:2rem;margin-top:3rem}
.step{text-align:center;padding:2rem 1.5rem}
.step-num{width:52px;height:52px;background:var(--orange);color:var(--white);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.4rem;margin:0 auto 1.25rem}
.step h3{font-weight:600;font-size:1.05rem;color:var(--navy);margin-bottom:.5rem}
.step p{font-size:.9rem;color:var(--muted);line-height:1.6}

/* PRICING */
.pricing{background:var(--gray);padding:5rem 2rem}
.pricing-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;margin-top:3rem}
.plan{background:var(--white);border:1px solid var(--border);border-radius:16px;padding:2rem;position:relative}
.plan.featured{border:2px solid var(--orange)}
.plan-badge{position:absolute;top:-13px;left:50%;transform:translateX(-50%);background:var(--orange);color:var(--white);font-size:.75rem;font-weight:700;padding:.3rem 1.1rem;border-radius:99px;white-space:nowrap;letter-spacing:.5px}
.plan-name{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.3rem;color:var(--navy);margin-bottom:.25rem}
.plan-price{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:3rem;color:var(--navy);line-height:1;margin:.75rem 0 .25rem}
.plan-price sup{font-size:1.4rem;vertical-align:top;margin-top:.4rem}
.plan-price span{font-size:1rem;font-weight:400;color:var(--muted)}
.plan-desc{font-size:.88rem;color:var(--muted);margin-bottom:1.5rem;padding-bottom:1.5rem;border-bottom:1px solid var(--border)}
.plan-features{list-style:none;display:flex;flex-direction:column;gap:.65rem;margin-bottom:2rem}
.plan-features li{font-size:.9rem;color:var(--text);display:flex;align-items:flex-start;gap:.6rem}
.plan-features li::before{content:'✓';color:var(--orange);font-weight:700;flex-shrink:0;margin-top:1px}
.plan-features li.no::before{content:'✕';color:#d1d5db}
.plan-features li.no{color:var(--muted)}
.plan-btn{width:100%;padding:.75rem;border-radius:8px;font-family:'Barlow',sans-serif;font-weight:600;font-size:.95rem;cursor:pointer;border:none;transition:all .2s}
.plan-btn.primary{background:var(--orange);color:var(--white)}
.plan-btn.primary:hover{background:var(--orange2)}
.plan-btn.outline{background:transparent;color:var(--navy);border:1.5px solid var(--border)}
.plan-btn.outline:hover{border-color:var(--navy)}

/* WHY US */
.why-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.5rem;margin-top:3rem}
.why-card{background:var(--gray);border-radius:12px;padding:1.5rem}
.why-icon{font-size:1.6rem;margin-bottom:.75rem}
.why-card h3{font-weight:600;color:var(--navy);margin-bottom:.4rem}
.why-card p{font-size:.88rem;color:var(--muted);line-height:1.6}

/* TESTIMONIAL */
.testimonial-section{background:var(--navy);padding:5rem 2rem;text-align:center}
.testimonial-section h2{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:2rem;color:var(--white);margin-bottom:3rem}
.testimonials{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;max-width:900px;margin:0 auto}
.tcard{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:1.5rem;text-align:left}
.tcard p{color:rgba(255,255,255,.75);font-size:.92rem;line-height:1.7;margin-bottom:1rem;font-style:italic}
.tcard-author{display:flex;align-items:center;gap:.75rem}
.tcard-avatar{width:38px;height:38px;border-radius:50%;background:var(--orange);display:flex;align-items:center;justify-content:center;font-family:'Barlow Condensed',sans-serif;font-weight:700;color:var(--white);font-size:.9rem}
.tcard-name{font-weight:600;font-size:.9rem;color:var(--white)}
.tcard-biz{font-size:.78rem;color:rgba(255,255,255,.5)}

/* SIGNUP FORM */
.signup-section{padding:5rem 2rem;background:var(--white)}
.signup-wrap{max-width:640px;margin:0 auto}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:2rem}
.form-group{display:flex;flex-direction:column;gap:.4rem}
.form-group.full{grid-column:1/-1}
.form-group label{font-size:.85rem;font-weight:600;color:var(--navy)}
.form-group input,.form-group select,.form-group textarea{padding:.7rem .9rem;border:1.5px solid var(--border);border-radius:8px;font-family:'Barlow',sans-serif;font-size:.95rem;color:var(--text);transition:border .2s}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{outline:none;border-color:var(--orange)}
.form-group textarea{resize:vertical;min-height:90px}
.form-submit{grid-column:1/-1;margin-top:.5rem}
.form-submit button{width:100%;padding:.85rem;background:var(--orange);color:var(--white);border:none;border-radius:8px;font-family:'Barlow',sans-serif;font-size:1rem;font-weight:600;cursor:pointer;transition:background .2s}
.form-submit button:hover{background:var(--orange2)}
.form-note{font-size:.78rem;color:var(--muted);text-align:center;margin-top:1rem}

/* FAQ */
.faq{background:var(--gray);padding:5rem 2rem}
.faq-list{margin-top:2.5rem;display:flex;flex-direction:column;gap:1rem;max-width:720px}
.faq-item{background:var(--white);border:1px solid var(--border);border-radius:10px;padding:1.25rem 1.5rem;cursor:pointer}
.faq-q{font-weight:600;color:var(--navy);font-size:.95rem;display:flex;justify-content:space-between;align-items:center;gap:1rem}
.faq-q::after{content:'+';color:var(--orange);font-size:1.3rem;font-weight:300;flex-shrink:0}
.faq-item.open .faq-q::after{content:'−'}
.faq-a{display:none;font-size:.9rem;color:var(--muted);margin-top:.85rem;line-height:1.7;border-top:1px solid var(--border);padding-top:.85rem}
.faq-item.open .faq-a{display:block}

footer{background:var(--navy2);color:rgba(255,255,255,.5);padding:2.5rem 2rem;text-align:center;font-size:.85rem}
footer strong{color:rgba(255,255,255,.85);font-family:'Barlow Condensed',sans-serif;font-size:1.1rem}
.footer-links{display:flex;justify-content:center;gap:2rem;margin:1rem 0;flex-wrap:wrap}
.footer-links a{color:rgba(255,255,255,.45);transition:color .2s}
.footer-links a:hover{color:var(--white)}

@media(max-width:600px){.stats-bar{gap:2rem}.form-grid{grid-template-columns:1fr}.nav-links{display:none}}
</style>
</head>
