<script>
function toggleFaq(el){
  const wasOpen=el.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(i=>i.classList.remove('open'));
  if(!wasOpen)el.classList.add('open');
}
function handleSubmit(){
  const name=document.querySelector('input[placeholder="First and last name"]').value;
  const lot=document.querySelector('input[placeholder="Your lot\'s name"]').value;
  if(!name||!lot){alert('Please fill in at least your name and dealership name.');return;}
  alert(`Thanks, ${name}! We received your request for ${lot}.\n\nWe'll be in touch within 24 hours to get your lot live on RGV Autos.`);
}
</script>
